# Only local, non-secret defaults. Never commit .env.
POSTGRES_DB=autodeploy
POSTGRES_USER=autodeploy
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
REDIS_URL=redis://redis:6379/0
AUTODEPLOY_GATEWAY_PORT=18080
SECRETS_MASTER_KEY=generate-a-32-byte-base64-key-before-any-real-deployment
JWT_SECRET=replace-with-at-least-32-random-characters
# Required only when accepting GitHub webhooks. Do not reuse JWT_SECRET.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
MANIFEST_SIGNING_KEY=generate-a-separate-base64-32-byte-key-for-agent-manifests
